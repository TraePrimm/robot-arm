"""
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "rebuild" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = [
        </rebuild/Physics/tn__Revolute12_oA>,
        </rebuild/Physics/tn__Slider13_k8>,
        </rebuild/Physics/tn__Slider14_k8>,
        </rebuild/Physics/tn__Revolute11_oA>,
        </rebuild/Physics/tn__Revolute10_oA>,
        </rebuild/Physics/tn__Revolute9_n9>,
        </rebuild/Physics/tn__Revolute8_n9>,
        </rebuild/Physics/tn__Revolute7_n9>,
        </rebuild/Physics/root_joint>,
    ]
    prepend rel isaac:physics:robotLinks = [
        </rebuild/Geometry/base_link/shoulder_link_1/upperarm_link_1/elbow_link_1/wrist_link_1/Wrist_pitch_1/Endo_link_1>,
        </rebuild/Geometry/base_link/shoulder_link_1/upperarm_link_1/elbow_link_1/wrist_link_1/Wrist_pitch_1>,
        </rebuild/Geometry/base_link/shoulder_link_1/upperarm_link_1/elbow_link_1/wrist_link_1>,
