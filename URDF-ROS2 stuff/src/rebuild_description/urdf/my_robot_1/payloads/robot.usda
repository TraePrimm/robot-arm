        </rebuild/Geometry/base_link/shoulder_link_1/upperarm_link_1/elbow_link_1/wrist_link_1/Wrist_pitch_1/Endo_link_1/activejaw_link_1>,
    ]
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
            over "shoulder_link_1" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
                over "upperarm_link_1" (
                    prepend apiSchemas = ["IsaacLinkAPI"]
                )
                {
                    over "elbow_link_1" (
                        prepend apiSchemas = ["IsaacLinkAPI"]
                    )
                    {
                        over "wrist_link_1" (
                            prepend apiSchemas = ["IsaacLinkAPI"]
                        )
                        {
                            over "Wrist_pitch_1" (
                                prepend apiSchemas = ["IsaacLinkAPI"]
                            )
                            {
                                over "Endo_link_1" (
                                    prepend apiSchemas = ["IsaacLinkAPI"]
                                )
                                {
                                    over "passivejaw_link_1" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                    }

                                    over "activejaw_link_1" (
                                        prepend apiSchemas = ["IsaacLinkAPI"]
                                    )
                                    {
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__Revolute7_n9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }

        over "tn__Revolute8_n9" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
