#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "rebuild"
    doc = """Generated from Composed Stage of root layer /tmp/tmp15u8wgao/rebuild.usdc


